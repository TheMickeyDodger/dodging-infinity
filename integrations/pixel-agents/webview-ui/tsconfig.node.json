{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "pngjs": ["./node_modules/@types/pngjs/index.d.ts"]
    },
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "allowUnreachableCode": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts", "../core/src/assets/**/*.ts", "test/**/*.ts"],
  /* type-checked by tsconfig.test-dom.json, which adds the DOM lib (and JSX) for the renderers (item 18: cityWeather and cityPersistence
     drive the real OfficeState and the test hooks, which import the renderer; they are listed in BOTH places on purpose, excluded here and
     included there, so none is left unchecked); the two living-city browser tests are type-checked by tsconfig.test-city.json (DOM lib, and
     the real server handler they import), and the tests that import the office's server modules by tsconfig.test-mission.json (the same
     options as test-city, so which of the two is a convention, not a technical constraint). Which program: test/diTypecheckCoverage.test.ts
     prints the rule, and FAILS on any test source no program builds. */
