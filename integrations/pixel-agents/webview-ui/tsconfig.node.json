{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "pngjs": ["./node_modules/@types/pngjs/index.d.ts"]
    },
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "allowUnreachableCode": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts", "../core/src/assets/**/*.ts", "test/**/*.ts"],
  /* type-checked by tsconfig.test-dom.json, which adds the DOM lib (and JSX) for the renderers (item 18: cityWeather and cityPersistence
     drive the real OfficeState and the test hooks, which import the renderer; they are listed in BOTH places on purpose, excluded here and
     included there, so none is left unchecked); the two living-city browser tests are type-checked by tsconfig.test-city.json (DOM lib, and
     the real server handler they import) */
  "exclude": [
    "test/cityWeather.test.ts",
    "test/cityPersistence.test.ts",
    "test/livingCityApp.test.ts",
    "test/livingCityTraffic.test.ts",
    "test/livingCityLoad.test.ts",
    "test/haloAura.test.ts",
    "test/renderContextRestore.test.ts",
    "test/diReceptionDesk.test.ts",
    "test/diRuntimeAgents.test.ts",
    "test/diPanelKeyboard.test.ts",
    "test/diReceptionInbox.test.ts",
    "test/diReceptionEntrances.test.ts",
    "test/diWorldSharedSpace.test.ts",
    "test/diVersionIndicator.test.ts",
    "test/diConstrainedExposure.test.ts",
    "test/diWorldYield.test.ts",
    "test/diCityFocus.test.ts",
    "test/diFixtureLabel.test.ts",
    "test/diReceptionSources.test.ts",
    "test/diOfficeNavigation.test.ts",
    "test/diInspector.test.ts",
    "test/diOperationalCases.test.ts",
    "test/diAppReconcile.test.ts",
    "test/diEvidenceLibrary.test.ts",
    "test/diCodeReview.test.ts",
    "test/diMissionRequest.test.ts",
    "test/diPlainSummary.test.ts",
    "test/diReceptionFinalCopy.test.ts",
    "test/diRenderedCopy.ts",
    "test/diModalStack.test.ts",
    "test/diServerWording.test.ts",
    "test/diCopyMarkers.test.ts",
    "test/diChromeA11y.ts",
    "test/diTokenScope.ts",
    "test/diChromeColourLiterals.test.ts",
    "test/diTextFit.ts",
    "test/diOcclusion.ts",
    "test/diPaintsAt.ts",
    "test/diReflow.ts",
    "test/diTabTraversal.ts",
    "test/harness/diAppProbe.ts"
  ]
}
